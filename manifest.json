{
  "manifest_version": 3,
  "name": "Ad-Morph Inspector",
  "version": "1.0",
  "description": "Capture web ads and convert them to editable JSON/HTML.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["highlighter.css"],
      "all_frames": true
    }
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}